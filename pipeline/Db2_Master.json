{
	"name": "Db2_Master",
	"properties": {
		"activities": [
			{
				"name": "Lookup1",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "select s.source_db_nm , s.source_schema_nm , s.source_table_nm , c.partition_seq , c.partition_where_clause , c.target_folder_path,  \nconcat('select * from ', s.source_schema_nm , '.' , s.source_table_nm , ' where ', c.partition_where_clause  , '  fetch first 1 rows only'  ) as query ,\nconcat(s.source_table_nm,  '_',  c.partition_seq) as filename\n FROM adf_init.init_load_control_v02 c\nINNER JOIN adf_common.source_table_master s\n    ON s.source_table_id = c.source_table_id",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SHIR_AzureSql_Table",
						"type": "DatasetReference",
						"parameters": {
							"p_domain_name": "dfafdbewdarfdf.database.windows.net",
							"p_db_name": "free-sql-db-2022585"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup1').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 2,
					"activities": [
						{
							"name": "CHILD_Common_DB2_copy1",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "CHILD_Common_DB2_copy1",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"db_name": {
										"value": "@item().source_db_nm",
										"type": "Expression"
									},
									"filename": {
										"value": "@item().filename",
										"type": "Expression"
									},
									"query": {
										"value": "@item().query",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"P_SRC_SYSTEM": {
				"type": "string"
			}
		},
		"folder": {
			"name": "MetaV0.1/INIT"
		},
		"annotations": []
	}
}