{
	"name": "COMMON_DB2_ADLS_GEN2_INGEST",
	"properties": {
		"activities": [
			{
				"name": "Common db2 adls gen2 ingest",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "Db2Source",
						"query": {
							"value": "@pipeline().parameters.p_query",
							"type": "Expression"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "SHIR_Db2_Table",
						"type": "DatasetReference",
						"parameters": {
							"p_server_name": {
								"value": "@pipeline().parameters.p_server_name",
								"type": "Expression"
							},
							"p_db_name": {
								"value": "@pipeline().parameters.p_db_name",
								"type": "Expression"
							},
							"p_id": {
								"value": "@pipeline().parameters.p_id",
								"type": "Expression"
							},
							"p_pwd_keyvalt": {
								"value": "@pipeline().parameters.p_pwd_keyvalt",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "SHIR_ADLS_GEN2_Parquet",
						"type": "DatasetReference",
						"parameters": {
							"p1": {
								"value": "@pipeline().parameters.p_folder",
								"type": "Expression"
							},
							"p2": {
								"value": "@pipeline().parameters.p_filename",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"p_server_name": {
				"type": "string",
				"defaultValue": "192.168.10.100:50000"
			},
			"p_db_name": {
				"type": "string",
				"defaultValue": "xmeta"
			},
			"p_id": {
				"type": "string",
				"defaultValue": "db2inst1"
			},
			"p_pwd_keyvalt": {
				"type": "string",
				"defaultValue": "db2"
			},
			"p_folder": {
				"type": "string",
				"defaultValue": "init/db2"
			},
			"p_filename": {
				"type": "string",
				"defaultValue": "test"
			},
			"p_query": {
				"type": "string",
				"defaultValue": "select * from db2inst1.lineitem fetch first 1 rows only"
			}
		},
		"folder": {
			"name": "MetaV0.1"
		},
		"annotations": []
	}
}