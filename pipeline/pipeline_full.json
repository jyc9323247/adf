{
	"name": "pipeline_full",
	"properties": {
		"activities": [
			{
				"name": "Lookup1",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Set variable1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzurePostgreSqlSource",
						"query": {
							"value": "SELECT t.target_id, t.src_type, t.src_db_nm, t.src_schema_nm, t.src_table_nm,\n       t.landing_path_tpl,\n       'FULL_REFRESH' AS incr_method,\n       '1=1'          AS incr_where,         \n       load_type,\n       incr_column_nm,\n       pending_yn\nFROM   \"META\".ctl_ingest_target_master t\nWHERE  t.is_active  = 'Y'\nAND    t.data_class = '@{variables('v_data_class')}'\nAND    t.src_db_nm  = '@{variables('v_src_db_name')}'\n-- (:p_exec_group 파라미터도 ADF 변수를 뜻하는 것이라면 아래와 같이 처리)\nAND    ('@{variables('v_exec_group')}' = '' OR t.exec_group = '@{variables('v_exec_group')}')\nAND    CASE\n         WHEN '@{variables('v_run_mode')}' = 'PENDING'\n              THEN (t.pending_yn = 'Y')                          -- 초기적재: load_type 무관\n         ELSE (t.load_type = 'full' AND t.pending_yn = 'N')      -- 주기 full refresh: 정규 반복\n       END\nORDER  BY t.src_db_nm, t.target_id;    -- DB별로 묶어 ingest 파이프라인 호출\n",
							"type": "Expression"
						},
						"partitionOption": "None",
						"queryTimeout": "02:00:00"
					},
					"dataset": {
						"referenceName": "AzurePostgreSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup1').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "If Condition1",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@if( equals(pipeline().parameters.P_IS_INIT_FULL,'Y' ), true, false  )",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "Script1_copy1",
										"type": "Script",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"linkedServiceName": {
											"referenceName": "AzurePostgreSql1",
											"type": "LinkedServiceReference"
										},
										"typeProperties": {
											"scripts": [
												{
													"type": "Query",
													"text": {
														"value": "update\n    \"META\".ctl_ingest_target_master\nset pending_yn = 'N'\nwhere\n    target_id = @{item().target_id} ;",
														"type": "Expression"
													}
												}
											],
											"scriptBlockExecutionTimeout": "02:00:00"
										}
									}
								]
							}
						},
						{
							"name": "If Condition  incr hwmark",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@and(equals( item().load_type,'incr' ), equals( item().pending_yn,'Y' ))",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "Lookup2",
										"type": "Lookup",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "Db2Source",
												"query": "select max(@{item().incr_column_nm}) as \"hwmark_value\" from @{item().src_schema_nm}.@{item().src_table_nm} ; \n"
											},
											"dataset": {
												"referenceName": "SHIR_Db2_Table",
												"type": "DatasetReference"
											}
										}
									},
									{
										"name": "Script1",
										"type": "Script",
										"dependsOn": [
											{
												"activity": "Lookup2",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"linkedServiceName": {
											"referenceName": "AzurePostgreSql1",
											"type": "LinkedServiceReference"
										},
										"typeProperties": {
											"scripts": [
												{
													"type": "Query",
													"text": {
														"value": "update\n    \"META\".ctl_ingest_target_master\nset incr_column_hw_val= '@{activity('Lookup2').output.firstRow.hwmark_value}'\nwhere\n    target_id = @{item().target_id} ;",
														"type": "Expression"
													}
												}
											],
											"scriptBlockExecutionTimeout": "02:00:00"
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "Set variable1",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_run_mode",
					"value": {
						"value": "@if(equals(pipeline().parameters.P_IS_INIT_FULL, 'Y'), 'PENDING', 'N')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"P_IS_INIT_FULL": {
				"type": "string",
				"defaultValue": "N"
			}
		},
		"variables": {
			"v_data_class": {
				"type": "String",
				"defaultValue": "raw"
			},
			"v_src_db_name": {
				"type": "String",
				"defaultValue": "xmeta"
			},
			"v_exec_group": {
				"type": "String"
			},
			"v_run_mode": {
				"type": "String"
			}
		},
		"annotations": []
	}
}