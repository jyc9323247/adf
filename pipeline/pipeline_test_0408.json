					}
				],
				"outputs": [
					{
						"referenceName": "SHIR_ADLS_GEN2_Parquet",
						"type": "DatasetReference",
						"parameters": {
							"p1": "tpch",
							"p2": "lineitem_enc1"
						}
					}
				]
			},
