			{
				"name": "Lkp_entry_result",
				"description": "진입에서 기동한 마스터 결과 집계 (Master 이력 entry_run_id)",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "ForEach_sched",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "AzurePostgreSql1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "/* Lkp_entry_result : 이번 진입(pipeline RunId)에서 기동한 마스터 결과 집계 (Master 이력의 entry_run_id 기준)\n   expected_cnt : p_sched_json 그룹 수. master_cnt 가 적으면 Master 행도 못 남기고 실패한 마스터 (검증 오류 등)\n   fail_cnt : FAILED Master. open_cnt : PENDING / RUNNING 으로 남은 Master (비정상 종료)\n   SKIPPED (전역 skip / NOT_BIZDAY / CALENDAR_MISSING) 는 정상으로 본다. ADF 동적 식은 p 에만 사용 */\nWITH p AS (\n    SELECT '@{pipeline().RunId}'::text                                 AS entry_run_id,\n           @{length(json(pipeline().parameters.p_sched_json))}::int    AS expected_cnt\n)\nSELECT p.expected_cnt,\n       count(m.master_run_id)::int                                                        AS master_cnt,\n       (count(m.master_run_id) FILTER (WHERE m.status = 'FAILED'))::int                   AS fail_cnt,\n       (count(m.master_run_id) FILTER (WHERE m.status IN ('PENDING', 'RUNNING')))::int    AS open_cnt,\n       (count(m.master_run_id) FILTER (WHERE m.status = 'SKIPPED'))::int                  AS skipped_cnt\n  FROM p\n  LEFT JOIN adfadm.ctl_master_pipeline_run m ON m.entry_run_id = p.entry_run_id\n GROUP BY p.expected_cnt;\n",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "00:10:00"
				}
			},
			{
				"name": "If_entry_failed",
				"description": "FAILED / 비정상 종료 / Master 미생성 마스터가 있거나 ForEach 가 실패했으면 진입도 실패 (알림용)",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Lkp_entry_result",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(greater(activity('Lkp_entry_result').output.resultSets[0].rows[0].fail_cnt, 0), or(greater(activity('Lkp_entry_result').output.resultSets[0].rows[0].open_cnt, 0), greater(sub(activity('Lkp_entry_result').output.resultSets[0].rows[0].expected_cnt, activity('Lkp_entry_result').output.resultSets[0].rows[0].master_cnt), 0)))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Fail_entry",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat('진입 실패 : 마스터 실패 ', string(activity('Lkp_entry_result').output.resultSets[0].rows[0].fail_cnt), ' / 비정상 종료 ', string(activity('Lkp_entry_result').output.resultSets[0].rows[0].open_cnt), ' / Master 미생성 ', string(sub(activity('Lkp_entry_result').output.resultSets[0].rows[0].expected_cnt, activity('Lkp_entry_result').output.resultSets[0].rows[0].master_cnt)), ' (그룹 ', string(activity('Lkp_entry_result').output.resultSets[0].rows[0].expected_cnt), '개, entry_run_id = ', pipeline().RunId, ')')",
									"type": "Expression"
								},
								"errorCode": "ENTRY_FAILED"
							}
						}
					]
