{
	"name": "pipeline_dispatcher",
	"properties": {
		"activities": [
			{
				"name": "Switch1",
				"type": "Switch",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@toLower(pipeline().parameters.p_child_pipeline_nm)",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "pl_raw_db2_xmeta",
							"activities": [
								{
									"name": "pl_raw_db2_xmeta",
									"type": "ExecutePipeline",
									"dependsOn": [
										{
											"activity": "Running_Update_Script",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "pl_raw_db2_xmeta",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"p_landing_path": {
												"value": "@pipeline().parameters.p_landing_path",
												"type": "Expression"
											},
											"p_file_name": {
												"value": "@pipeline().parameters.p_file_name",
												"type": "Expression"
											},
											"p_extract_query": {
												"value": "@pipeline().parameters.p_extract_query",
												"type": "Expression"
											}
										}
									}
								},
								{
									"name": "Succeeded_UPDATE",
									"type": "Script",
									"dependsOn": [
										{
											"activity": "pl_raw_db2_xmeta",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "AzurePostgreSql1",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "UPDATE \"ADFADM\".ctl_ingest_pipeline_run\nSET\n    status    = 'SUCCEEDED',\n    ingest_pipeline_run_id  ='@{activity('pl_raw_db2_xmeta').output.pipelineRunId}',\n      extract_cnt  = @{activity('pl_raw_db2_xmeta').output.pipelineReturnValue.rowsRead},\n    save_cnt     = @{activity('pl_raw_db2_xmeta').output.pipelineReturnValue.rowsCopied},\n    file_size_mb = @{div(activity('pl_raw_db2_xmeta').output.pipelineReturnValue.dataWritten,1048576)},\n    end_dt    = NOW(),\n    error_log = NULL,\n    update_by = 'ADF',\n    update_dt = NOW()\nWHERE master_run_id      = '@{pipeline().parameters.p_master_run_id}'\n  AND ingest_pipeline_id = '@{pipeline().parameters.p_ingest_pipeline_id}';\n\n\n",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								},
								{
									"name": "Failed_UPDATE",
									"type": "Script",
									"dependsOn": [
										{
											"activity": "pl_raw_db2_xmeta",
											"dependencyConditions": [
												"Failed"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "AzurePostgreSql1",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "UPDATE \"ADFADM\".ctl_ingest_pipeline_run\nSET\n    status    = 'FAILED',\n    ingest_pipeline_run_id  ='@{activity('pl_raw_db2_xmeta').output.pipelineRunId}',\n    error_log = \t NULLIF(\n        '@{replace(activity('pl_raw_db2_xmeta').output.pipelineReturnValue.error.message,'''','''''')}',\n        ''\n    ),\n    end_dt    = NOW(),\n    update_by = 'ADF',\n    update_dt = NOW()\nWHERE master_run_id      = '@{pipeline().parameters.p_master_run_id}'\n  AND ingest_pipeline_id = '@{pipeline().parameters.p_ingest_pipeline_id}';",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								},
								{
									"name": "Running_Update_Script",
									"type": "Script",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "AzurePostgreSql1",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "UPDATE \"ADFADM\".ctl_ingest_pipeline_run\nSET\n    status                 = 'RUNNING',\n    start_dt               = NOW(),\n    attempt_no             = attempt_no + 1,\n    update_by              = 'ADF',\n    update_dt              = NOW()\nWHERE master_run_id       = '@{pipeline().parameters.p_master_run_id}'\n  AND ingest_pipeline_id  = '@{pipeline().parameters.p_ingest_pipeline_id}';\n\n\n",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								}
							]
						}
					],
					"defaultActivities": [
						{
							"name": "Fail1",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "Failed dispacher",
								"errorCode": "-1"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_child_pipeline_nm": {
				"type": "string"
			},
			"p_landing_path": {
				"type": "string"
			},
			"p_file_name": {
				"type": "string"
			},
			"p_extract_query": {
				"type": "string"
			},
			"p_ingest_pipeline_id": {
				"type": "string"
			},
			"p_master_run_id": {
				"type": "string"
			}
		},
		"variables": {
			"v_yyyyMMddHHmmss": {
				"type": "String"
			}
		},
		"annotations": []
	}
}