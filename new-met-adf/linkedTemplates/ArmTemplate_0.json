		{
			"name": "[concat(parameters('factoryName'), '/pl_ctl_master_pipeline_run')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "pl_ctl_master_pipeline_run",
						"type": "Switch",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"on": {
								"value": "@pipeline().parameters.p_call_type",
								"type": "Expression"
							},
							"cases": [
								{
									"value": "START",
									"activities": [
										{
											"name": "START_ctl_master_pipeline_run_script",
											"type": "Script",
											"dependsOn": [],
											"policy": {
												"timeout": "0.00:10:00",
												"retry": 2,
												"retryIntervalInSeconds": 30,
												"secureOutput": false,
												"secureInput": false
											},
											"userProperties": [],
											"linkedServiceName": {
												"referenceName": "ls_egress_postgres_MLKUDPD",
												"type": "LinkedServiceReference"
											},
											"typeProperties": {
												"scripts": [
													{
														"type": "Query",
														"text": {
															"value": "INSERT INTO \"ADFADM\".ctl_master_pipeline_run\n(\n    master_run_id,\n    master_pipeline_nm,\n    trigger_id,\n    trigger_nm,\n    data_class,\n    ingest_type,\n    init_yn,\n    start_dt,\n    end_dt,\n    exec_group,\n    child_total_cnt,\n    child_succ_cnt,\n    child_fail_cnt,\n    status,\n    run_mode,\n    created_by,\n    created_dt\n)\nVALUES\n(\n    '@{pipeline().parameters.p_master_run_id}',\n    '@{pipeline().parameters.p_master_pipeline_nm}',\n    '@{pipeline().parameters.p_trigger_id}',\n    '@{pipeline().parameters.p_trigger_nm}',\n    '@{pipeline().parameters.p_data_class}',\n    '@{pipeline().parameters.p_ingest_type}',\n    'N',\n    NOW(),\n    NULL,\n    NULL,\n    (select count(1)\nFROM \"ADFADM\".ctl_ingest_target_master m\n    WHERE m.data_class = '@{pipeline().parameters.p_data_class}'\n     AND m.ingest_type = '@{pipeline().parameters.p_ingest_type}'\n     AND m.init_wait_yn = 'N'\n     AND m.delete_yn = 'N'),\n    0,\n    0,\n    '@{pipeline().parameters.p_status}',\n    '@{pipeline().parameters.p_runmode}',\n    'ADF',\n    NOW()\n);",
															"type": "Expression"
														}
													}
												],
												"scriptBlockExecutionTimeout": "02:00:00"
											}
										}
									]
								},
								{
									"value": "UPDATE",
									"activities": [
										{
											"name": "UPDATE_ctl_master_pipeline_run_script",
											"type": "Script",
											"dependsOn": [],
											"policy": {
												"timeout": "0.00:10:00",
												"retry": 2,
												"retryIntervalInSeconds": 30,
												"secureOutput": false,
												"secureInput": false
											},
											"userProperties": [],
											"linkedServiceName": {
												"referenceName": "ls_egress_postgres_MLKUDPD",
												"type": "LinkedServiceReference"
											},
											"typeProperties": {
												"scripts": [
													{
														"type": "Query",
														"text": {
															"value": "UPDATE \"ADFADM\".ctl_master_pipeline_run m\nSET\n    child_total_cnt = s.child_total_cnt,\n    child_succ_cnt  = s.child_succ_cnt,\n    child_fail_cnt  = s.child_fail_cnt,\n    end_dt          = NOW(),\n    status           = '@{pipeline().parameters.p_status}',\n    update_by        = 'ADF',\n    update_dt        = NOW()\nFROM\n(\n    SELECT\n        COUNT(*)::int4 AS child_total_cnt,\n        COUNT(*) FILTER (\n            WHERE status = 'SUCCEEDED'\n        )::int4 AS child_succ_cnt,\n        COUNT(*) FILTER (\n            WHERE status = 'FAILED'\n        )::int4 AS child_fail_cnt\n    FROM \"ADFADM\".ctl_ingest_pipeline_run\n    WHERE master_run_id = '@{pipeline().parameters.p_master_run_id}'\n) s\nWHERE m.master_run_id = '@{pipeline().parameters.p_master_run_id}';",
															"type": "Expression"
														}
													}
												],
												"scriptBlockExecutionTimeout": "02:00:00"
											}
										}
									]
								},
								{
									"value": "INIT_START",
									"activities": [
										{
											"name": "INIT_START_ctl_master_pipeline_run_script",
											"type": "Script",
											"dependsOn": [],
											"policy": {
												"timeout": "0.00:10:00",
												"retry": 2,
												"retryIntervalInSeconds": 30,
												"secureOutput": false,
												"secureInput": false
											},
											"userProperties": [],
											"linkedServiceName": {
												"referenceName": "ls_egress_postgres_MLKUDPD",
												"type": "LinkedServiceReference"
											},
											"typeProperties": {
												"scripts": [
													{
														"type": "Query",
														"text": {
															"value": "INSERT INTO \"ADFADM\".ctl_master_pipeline_run\n(\n    master_run_id,\n    master_pipeline_nm,\n    trigger_id,\n    trigger_nm,\n    data_class,\n    ingest_type,\n    init_yn,\n    start_dt,\n    end_dt,\n    exec_group,\n    child_total_cnt,\n    child_succ_cnt,\n    child_fail_cnt,\n    status,\n    run_mode,\n    created_by,\n    created_dt\n)\nVALUES\n(\n    '@{pipeline().parameters.p_master_run_id}',\n    '@{pipeline().parameters.p_master_pipeline_nm}',\n    '@{pipeline().parameters.p_trigger_id}',\n    '@{pipeline().parameters.p_trigger_nm}',\n    '@{pipeline().parameters.p_data_class}',\n    '@{pipeline().parameters.p_ingest_type}',\n    'Y',\n    NOW(),\n    NULL,\n    NULL,\n\n    (\n        SELECT\n            COALESCE(\n                SUM(\n                    CASE\n                        WHEN NULLIF(TRIM(m.partition_clause), '') IS NULL\n                            THEN 1\n\n                        WHEN jsonb_typeof(\n                                 NULLIF(m.partition_clause, '')::jsonb\n                                 -> 'partition_val'\n                             ) = 'array'\n                            THEN jsonb_array_length(\n                                     NULLIF(m.partition_clause, '')::jsonb\n                                     -> 'partition_val'\n                                 )\n\n                        ELSE 1\n                    END\n                ),\n                0\n            )::int4\n\n        FROM \"ADFADM\".ctl_ingest_target_master m\n\n        WHERE  m.init_wait_yn =\n              'Y'\n\n          AND m.delete_yn = 'N'\n    ),\n\n    0,\n    0,\n    '@{pipeline().parameters.p_status}',\n    '@{pipeline().parameters.p_runmode}',\n    'ADF',\n    NOW()\n);",
															"type": "Expression"
														}
													}
												],
												"scriptBlockExecutionTimeout": "02:00:00"
											}
										}
									]
								}
							],
							"defaultActivities": [
								{
									"name": "Failed pl_ctl_master_pipeline_run_script",
									"type": "Fail",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"message": "fail",
										"errorCode": "-1"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"p_master_run_id": {
						"type": "string"
					},
					"p_master_pipeline_nm": {
						"type": "string"
					},
					"p_trigger_id": {
						"type": "string"
					},
					"p_trigger_nm": {
						"type": "string"
					},
					"p_data_class": {
						"type": "string"
					},
					"p_ingest_type": {
						"type": "string"
					},
					"p_status": {
						"type": "string"
					},
					"p_runmode": {
						"type": "string"
					},
					"p_call_type": {
						"type": "string"
					}
				},
				"folder": {
					"name": "util/sop"
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_egress_postgres_MLKUDPD')]"
			]
		},
