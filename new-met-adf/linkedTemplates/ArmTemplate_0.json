			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Script1",
						"type": "Script",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "AzurePostgreSql1",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": {
										"value": "INSERT INTO \"ADFADM\".ctl_trigger_history\n(\n    trigger_id,\n    trigger_nm,\n    master_run_id,\n    master_pipeline_nm,\n    skip_yn,\n    skip_reason,\n    created_by,\n    created_dt,\n    update_by,\n    update_dt\n)\nVALUES\n(\n    '@{pipeline().parameters.p_trigger_id}',\n    '@{pipeline().parameters.p_trigger_nm}',\n    '@{pipeline().parameters.p_master_run_id}',\n    '@{pipeline().parameters.p_master_pipeline_nm}',\n    '@{pipeline().parameters.p_skip_yn}',\n\n    NULLIF(\n        '@{replace(\n            pipeline().parameters.p_skip_reason,\n            '''',\n            ''''''\n        )}',\n        ''\n    ),\n\n    'ADF',\n    NOW(),\n    NULL,\n    NULL\n);",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"p_trigger_id": {
						"type": "string"
					},
					"p_trigger_nm": {
						"type": "string"
					},
					"p_master_run_id": {
						"type": "string"
					},
					"p_master_pipeline_nm": {
						"type": "string"
					},
					"p_skip_yn": {
						"type": "string"
					},
					"p_skip_reason": {
						"type": "string"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzurePostgreSql1')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/set_master_pipeline_function')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Switch1",
						"type": "Switch",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"on": {
								"value": "@pipeline().parameters.p_type",
								"type": "Expression"
							},
							"cases": [
								{
									"value": "START",
									"activities": [
										{
											"name": "START_Script",
											"type": "Script",
											"dependsOn": [],
											"policy": {
												"timeout": "0.12:00:00",
												"retry": 0,
												"retryIntervalInSeconds": 30,
												"secureOutput": false,
												"secureInput": false
											},
											"userProperties": [],
											"linkedServiceName": {
												"referenceName": "AzurePostgreSql1",
												"type": "LinkedServiceReference"
											},
											"typeProperties": {
												"scripts": [
													{
														"type": "Query",
														"text": {
															"value": "INSERT INTO \"ADFADM\".ctl_master_pipeline_run\n(\n    master_run_id,\n    master_pipeline_nm,\n    trigger_id,\n    trigger_nm,\n    data_class,\n    ingest_type,\n    init_yn,\n    start_dt,\n    end_dt,\n    exec_group,\n    child_total_cnt,\n    child_succ_cnt,\n    child_fail_cnt,\n    status,\n    run_mode,\n    created_by,\n    created_dt\n)\nVALUES\n(\n    '@{pipeline().parameters.p_master_run_id}',\n    '@{pipeline().parameters.p_master_pipeline_nm}',\n    '@{pipeline().parameters.p_trigger_id}',\n    '@{pipeline().parameters.p_trigger_nm}',\n    '@{pipeline().parameters.p_data_class}',\n    '@{pipeline().parameters.p_ingest_type}',\n    '@{pipeline().parameters.p_init_yn}'::bpchar,\n    NOW(),\n    NULL,\n    NULL,\n    (select count(1)\nFROM \"ADFADM\".ctl_ingest_target_master m\n    WHERE m.data_class = '@{pipeline().parameters.p_data_class}'\n     AND m.ingest_type = '@{pipeline().parameters.p_ingest_type}'\n     AND m.init_wait_yn = '@{pipeline().parameters.p_init_yn}'::bpchar\n     AND m.delete_yn = 'N'),\n    0,\n    0,\n    '@{pipeline().parameters.p_status}',\n    '@{pipeline().parameters.p_runmode}',\n    'ADF',\n    NOW()\n);",
															"type": "Expression"
														}
													}
												],
												"scriptBlockExecutionTimeout": "02:00:00"
											}
										}
									]
								},
								{
									"value": "UPDATE",
									"activities": [
										{
											"name": "UPDATE_Script",
											"type": "Script",
											"dependsOn": [],
											"policy": {
												"timeout": "0.12:00:00",
												"retry": 0,
												"retryIntervalInSeconds": 30,
												"secureOutput": false,
												"secureInput": false
											},
											"userProperties": [],
											"linkedServiceName": {
												"referenceName": "AzurePostgreSql1",
												"type": "LinkedServiceReference"
											},
											"typeProperties": {
												"scripts": [
													{
														"type": "Query",
														"text": {
															"value": "UPDATE \"ADFADM\".ctl_master_pipeline_run m\nSET\n    child_total_cnt = s.child_total_cnt,\n    child_succ_cnt  = s.child_succ_cnt,\n    child_fail_cnt  = s.child_fail_cnt,\n    end_dt          = NOW(),\n    status           = '@{pipeline().parameters.p_status}',\n    update_by        = 'ADF',\n    update_dt        = NOW()\nFROM\n(\n    SELECT\n        COUNT(*)::int4 AS child_total_cnt,\n        COUNT(*) FILTER (\n            WHERE status = 'SUCCEEDED'\n        )::int4 AS child_succ_cnt,\n        COUNT(*) FILTER (\n            WHERE status = 'FAILED'\n        )::int4 AS child_fail_cnt\n    FROM \"ADFADM\".ctl_ingest_pipeline_run\n    WHERE master_run_id = '@{pipeline().parameters.p_master_run_id}'\n) s\nWHERE m.master_run_id = '@{pipeline().parameters.p_master_run_id}';",
															"type": "Expression"
														}
													}
												],
												"scriptBlockExecutionTimeout": "02:00:00"
											}
										}
									]
								}
							],
							"defaultActivities": [
								{
									"name": "Fail1",
									"type": "Fail",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"message": "fail",
										"errorCode": "-1"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"p_master_run_id": {
						"type": "string"
					},
					"p_master_pipeline_nm": {
						"type": "string"
					},
					"p_trigger_id": {
						"type": "string"
					},
					"p_trigger_nm": {
						"type": "string"
					},
					"p_data_class": {
						"type": "string"
					},
					"p_ingest_type": {
						"type": "string"
					},
					"p_init_yn": {
						"type": "string"
					},
					"p_status": {
						"type": "string"
					},
					"p_runmode": {
						"type": "string"
					},
					"p_type": {
						"type": "string"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzurePostgreSql1')]"
			]
