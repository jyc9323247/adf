{
	"name": "Db21",
	"properties": {
		"parameters": {
			"server_name": {
				"type": "string",
				"defaultValue": "192.168.10.100:50000"
			},
			"db_name": {
				"type": "string",
				"defaultValue": "xmeta"
			},
			"id": {
				"type": "string",
				"defaultValue": "db2inst1"
			},
			"keyvalt_db2_sec": {
				"type": "string",
				"defaultValue": "db2"
			}
		},
		"annotations": [],
		"type": "Db2",
		"typeProperties": {
			"connectionString": "server=@{linkedService().server_name};database=@{linkedService().db_name};username=@{linkedService().id};authenticationType=Basic",
			"password": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "AzureKeyVault1",
					"type": "LinkedServiceReference"
				},
				"secretName": {
					"value": "@linkedService().keyvalt_db2_sec",
					"type": "Expression"
				}
			}
		},
		"connectVia": {
			"referenceName": "integrationRuntime1",
			"type": "IntegrationRuntimeReference"
		}
	},
	"type": "Microsoft.DataFactory/factories/linkedservices"
}